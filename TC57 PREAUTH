    // --- START MODIFICATION 2: TRAN_TYPE_ID CORRECTION ---
    string strCurrentTranType = m_hGenericSegment[0].get("TRAN_TYPE_ID");

    // Identify if the transaction is a Void Authorization (MTI 140/240) AND check the field length
    if ((m_hGenericSegment[0].get("MTI") == "140" || m_hGenericSegment[0].get("MTI") == "240") && strCurrentTranType.length() >= 7)
